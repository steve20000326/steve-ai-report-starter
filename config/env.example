# Steve AI Report Starter - 环境变量示例
# 复制此文件为 .env 并填入真实值，切勿提交 .env 到版本库

# 微信云开发环境 ID
CLOUD_ENV_ID=cloud1-d5gy8cytj61fdbfdd

# DeepSeek API Key（在云开发控制台 → 云函数 → 环境变量 中配置，禁止写入前端）
DEEPSEEK_API_KEY=your-deepseek-api-key

# DeepSeek API 地址
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# 默认模型
DEEPSEEK_MODEL=deepseek-chat

# 免费额度（每用户）
DEFAULT_FREE_QUOTA=3

# 开发测试模式（前端 constants/testConfig.js 中 TEST_MODE，正式环境必须为 false）
# TEST_MODE=false

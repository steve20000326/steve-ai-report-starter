.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.first-banner {
  background: #EDF5EF;
  color: #65A87C;
  font-size: 26rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.optional-note {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.note-input {
  width: 100%;
  min-height: 100rpx;
  font-size: 28rpx;
  color: #26352C;
  line-height: 1.6;
}

.test-panel {
  background: #FFF8E8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.test-label {
  font-size: 22rpx;
  color: #B8860B;
  margin-bottom: 12rpx;
}

.test-item {
  font-size: 24rpx;
  color: #7C857F;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0E8D0;
}

.test-item:last-child {
  border-bottom: none;
}

.header {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #26352C;
  line-height: 1.4;
}

.child-info {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7C857F;
}

.input-area {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #26352C;
  margin-bottom: 20rpx;
}

.main-input {
  width: 100%;
  min-height: 280rpx;
  font-size: 30rpx;
  color: #26352C;
  line-height: 1.7;
  box-sizing: border-box;
}

.input-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7C857F;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tag-item {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  color: #7C857F;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.tag-item.active {
  background: #EDF5EF;
  color: #65A87C;
}

.submit-btn {
  height: 92rpx;
  line-height: 92rpx;
  background: #65A87C !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.submit-btn[disabled] {
  background: #C5D5CA !important;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(247, 247, 243, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
  box-sizing: border-box;
}

.loading-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
}

.loading-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #26352C;
  text-align: center;
  margin-bottom: 40rpx;
}

.loading-steps {
  margin-bottom: 32rpx;
}

.step {
  font-size: 28rpx;
  color: #7C857F;
  padding: 12rpx 0;
  line-height: 1.6;
}

.step.done {
  color: #65A87C;
}

.loading-note {
  font-size: 24rpx;
  color: #7C857F;
  line-height: 1.7;
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDF5EF;
}

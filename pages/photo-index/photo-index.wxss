.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #F4F0E8;
}

.hero {
  padding: 24rpx 0 48rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #332E28;
  margin-bottom: 24rpx;
}

.hero-line {
  font-size: 32rpx;
  color: #332E28;
  line-height: 1.5;
}

.hero-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8B857D;
  line-height: 1.7;
}

.main-cta {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: #9A7553 !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.example-card {
  background: #FFFCF6;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.example-year {
  font-size: 24rpx;
  color: #9A7553;
  margin-bottom: 12rpx;
}

.example-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #332E28;
  margin-bottom: 16rpx;
}

.example-preview {
  font-size: 26rpx;
  color: #8B857D;
  line-height: 1.8;
}

.link-history {
  text-align: center;
  font-size: 28rpx;
  color: #9A7553;
  padding: 24rpx;
}

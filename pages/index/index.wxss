.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.hero {
  padding: 16rpx 0 48rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #26352C;
  margin-bottom: 24rpx;
}

.hero-line {
  font-size: 32rpx;
  color: #26352C;
  line-height: 1.5;
}

.hero-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #7C857F;
  line-height: 1.7;
}

.main-cta {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: #65A87C !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.empty-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #26352C;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7C857F;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

.btn-outline {
  height: 88rpx;
  line-height: 88rpx;
  background: #EDF5EF !important;
  color: #65A87C !important;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 26rpx;
  color: #7C857F;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.child-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.child-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
}

.child-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.child-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #26352C;
}

.child-age {
  font-size: 26rpx;
  color: #7C857F;
}

.child-stats {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7C857F;
  line-height: 1.6;
}

.dot {
  margin: 0 8rpx;
}

.child-actions {
  margin-top: 28rpx;
}

.btn-record {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #EDF5EF !important;
  color: #65A87C !important;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.example-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-top: 8rpx;
}

.example-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #26352C;
  margin-bottom: 24rpx;
}

.example-block {
  margin-bottom: 20rpx;
}

.example-block.highlight {
  background: #EDF5EF;
  border-radius: 16rpx;
  padding: 20rpx;
}

.example-label {
  font-size: 24rpx;
  color: #7C857F;
  margin-bottom: 8rpx;
}

.example-text {
  font-size: 28rpx;
  color: #26352C;
  line-height: 1.7;
}

.example-keywords {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.kw-label {
  font-size: 24rpx;
  color: #7C857F;
  margin-right: 12rpx;
}

.kw-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: #EDF5EF;
  color: #65A87C;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.loading-hint {
  text-align: center;
  padding: 32rpx;
  color: #7C857F;
  font-size: 26rpx;
}

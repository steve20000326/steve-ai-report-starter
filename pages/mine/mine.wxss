.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #26352C;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7C857F;
}

.stats-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F0ED;
}

.stat-row:last-child {
  border-bottom: none;
}

.stat-label {
  font-size: 28rpx;
  color: #7C857F;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #26352C;
}

.menu-list {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0ED;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 30rpx;
  color: #26352C;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C5D5CA;
}

.loading-hint {
  text-align: center;
  padding: 32rpx;
  color: #7C857F;
  font-size: 26rpx;
}

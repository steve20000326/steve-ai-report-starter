<view class="page">
  <view class="header">
    <view class="header-title">我的家庭</view>
    <view class="header-sub">家庭成长档案</view>
  </view>

  <view class="stats-card">
    <view class="stat-row">
      <text class="stat-label">孩子数量</text>
      <text class="stat-value">{{childCount}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">成长记录数量</text>
      <text class="stat-value">{{reportCount}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">陪伴记录天数</text>
      <text class="stat-value">{{companionDays}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view
      class="menu-item"
      wx:for="{{menuItems}}"
      wx:key="id"
      data-action="{{item.action}}"
      data-url="{{item.url}}"
      data-tab="{{item.tab}}"
      bindtap="onMenuTap"
    >
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-hint">加载中…</view>
</view>

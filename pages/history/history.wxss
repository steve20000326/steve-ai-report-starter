.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #7C857F;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 48rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #26352C;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #7C857F;
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  background: #65A87C !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 30rpx;
  max-width: 400rpx;
  margin: 0 auto;
}

.month-group {
  margin-bottom: 40rpx;
}

.month-label {
  font-size: 26rpx;
  color: #7C857F;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.record-item {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.record-item.weak {
  opacity: 0.75;
}

.record-item.failed {
  border-left: 6rpx solid #C47A6E;
}

.record-date {
  font-size: 24rpx;
  color: #7C857F;
  margin-bottom: 8rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #26352C;
  line-height: 1.5;
}

.record-keywords {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.kw {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #EDF5EF;
  color: #65A87C;
  border-radius: 20rpx;
  font-size: 22rpx;
}

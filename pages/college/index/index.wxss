.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f7f7f3;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e36;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7c857f;
}

.feature-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin-bottom: 32rpx;
}

.feature {
  font-size: 24rpx;
  color: #4a6fa5;
  background: rgba(74, 111, 165, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.placeholder-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.placeholder-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e36;
  margin-bottom: 12rpx;
}

.placeholder-desc {
  font-size: 26rpx;
  color: #7c857f;
  line-height: 1.7;
}

.btn-back {
  background: #4a6fa5;
  color: #fff;
  border-radius: 16rpx;
  border: none;
}

.btn-back::after {
  border: none;
}

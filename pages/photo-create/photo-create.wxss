.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background: #F4F0E8;
}

.photo-wrap {
  background: #FFFCF6;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  max-height: 400rpx;
}

.photo {
  width: 100%;
  max-height: 400rpx;
  display: block;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #332E28;
  margin-bottom: 24rpx;
}

.form-card {
  background: #FFFCF6;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #8B857D;
  margin-bottom: 12rpx;
}

.input,
.picker-hint {
  font-size: 28rpx;
  color: #332E28;
  padding: 12rpx 0;
}

.memory-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  color: #332E28;
  line-height: 1.7;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #332E28;
}

.extra-toggle {
  text-align: center;
  font-size: 26rpx;
  color: #9A7553;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.style-section {
  margin: 32rpx 0;
}

.style-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.style-tag {
  padding: 12rpx 28rpx;
  background: #FFFCF6;
  color: #8B857D;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.style-tag.active {
  background: #EDE6DA;
  color: #9A7553;
}

.submit-btn {
  height: 92rpx;
  line-height: 92rpx;
  background: #9A7553 !important;
  color: #fff !important;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(244, 240, 232, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}

.loading-card {
  background: #FFFCF6;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 100%;
}

.loading-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #332E28;
  text-align: center;
  margin-bottom: 32rpx;
}

.step {
  font-size: 28rpx;
  color: #8B857D;
  padding: 10rpx 0;
}

.step.done {
  color: #9A7553;
}

.loading-note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8B857D;
  text-align: center;
  line-height: 1.6;
  border-top: 1rpx solid #EDE6DA;
  padding-top: 20rpx;
}

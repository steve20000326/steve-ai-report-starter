.page {
  padding: 32rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #7C857F;
  font-size: 28rpx;
}

.timeline-item {
  display: flex;
  margin-bottom: 24rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background: #65A87C;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.content {
  flex: 1;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
  color: #26352C;
}

.summary {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7C857F;
  line-height: 1.6;
}

.meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7C857F;
  display: flex;
  justify-content: space-between;
}

.status {
  color: #65A87C;
}

.status-failed {
  color: #C47A6E;
}

.timeline-item.weak .content {
  opacity: 0.75;
}

.timeline-item.failed .content {
  border-left: 6rpx solid #C47A6E;
}

.dot-failed {
  background: #C47A6E !important;
}

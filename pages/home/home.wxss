.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  background: #f7f7f3;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 40rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #2c3e36;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 28rpx;
  color: #6b756f;
  margin-bottom: 16rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #65a87c;
  background: rgba(101, 168, 124, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.tool-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tool-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(44, 62, 54, 0.06);
}

.tool-head {
  margin-bottom: 12rpx;
}

.tool-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e36;
}

.tool-desc {
  font-size: 26rpx;
  color: #7c857f;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.tool-btn {
  width: 100%;
  background: #65a87c;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
}

.tool-btn::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 48rpx;
  background: #F4F0E8;
  box-sizing: border-box;
}

.status, .generating, .failed {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #8B857D;
}

.subtitle {
  font-size: 26rpx;
  color: #9A7553;
  margin-bottom: 24rpx;
}

.photo {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  background: #FFFCF6;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #332E28;
  line-height: 1.4;
  margin-bottom: 28rpx;
}

.opening, .story-body, .closing {
  font-size: 28rpx;
  color: #332E28;
  line-height: 1.9;
  margin-bottom: 32rpx;
}

.story-body {
  text-indent: 2em;
}

.details {
  background: #FFFCF6;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.details-label {
  font-size: 24rpx;
  color: #8B857D;
  margin-bottom: 12rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #332E28;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.fact-note {
  font-size: 22rpx;
  color: #8B857D;
  font-style: italic;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.feedback {
  background: #FFFCF6;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.feedback-title {
  font-size: 28rpx;
  color: #332E28;
  text-align: center;
  margin-bottom: 20rpx;
}

.fb-btns {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.fb-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #EDE6DA;
  color: #8B857D;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.fb-btn.on {
  background: #9A7553;
  color: #fff;
}

.fb-comment {
  width: 100%;
  min-height: 80rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  background: #9A7553 !important;
  color: #fff !important;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.btn-secondary {
  height: 88rpx;
  line-height: 88rpx;
  background: #EDE6DA !important;
  color: #9A7553 !important;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  width: 750px;
  height: 1000px;
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(51, 46, 40, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 48rpx;
}

.modal-body {
  background: #FFFCF6;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 100%;
}

.modal-title {
  text-align: center;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  color: #332E28;
}

.card-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.loading-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #332E28;
  margin-bottom: 24rpx;
}

.step {
  font-size: 28rpx;
  color: #8B857D;
  padding: 8rpx 0;
  text-align: left;
}

.step.done {
  color: #9A7553;
}

.loading-note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8B857D;
}

.feedback-done {
  text-align: center;
  color: #9A7553;
  padding: 24rpx;
}
